{
  "name": "mars-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test apps packages scripts",
    "audit:sources": "bun scripts/check-sources.ts",
    "audit:sources:remote": "bun scripts/check-remote-sources.ts",
    "doctor": "bun apps/cli/src/main.ts doctor",
    "smoke:execution": "bun apps/cli/src/main.ts smoke",
    "build": "bun build apps/cli/src/main.ts packages/providers/src/index.ts --target=bun --packages=external --outdir dist",
    "check": "bun run lint && bun run typecheck && bun run audit:sources && bun run test && bun run smoke:execution && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.3",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  }
}
